<Window x:Class="GameTranslatorUltimate.AccuracyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Report_Title}"
        Width="800"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Style="{DynamicResource ThemedWindow}">

    <Window.Resources>

        <Style x:Key="HeaderStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="16"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="0,10,0,5"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="LabelStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,5,0,2"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ValueStyle"
               TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="0,5,0,2"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}"
                Padding="18,14">

            <StackPanel>

                <TextBlock Text="{DynamicResource Str_Report_Header}"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock x:Name="ReportDateText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="White"
                           Opacity="0.80"/>

            </StackPanel>

        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <GroupBox Header="{DynamicResource Str_Report_Summary}"
                          Margin="0,0,0,10">

                    <Grid Margin="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="{DynamicResource Str_Report_TotalTests}"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="TotalTestsText"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Text="0"
                                   Style="{StaticResource ValueStyle}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="{DynamicResource Str_Report_OverallAccuracy}"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="OverallAccuracyText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="N/A"
                                   Style="{StaticResource ValueStyle}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="{DynamicResource Str_Report_BestEngine}"
                                   Style="{StaticResource LabelStyle}"/>

                        <TextBlock x:Name="BestEngineText"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   Text="None"
                                   Style="{StaticResource ValueStyle}"/>

                    </Grid>

                </GroupBox>

                <GroupBox Header="{DynamicResource Str_Report_EnginePerformance}"
                          Margin="0,0,0,10">

                    <Grid Margin="10">

                        <ListView x:Name="EnginePerformanceListView"
                                  Height="200"
                                  Style="{DynamicResource ThemedListView}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}"
                                                    Width="120"
                                                    DisplayMemberBinding="{Binding EngineType}"/>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Tests}"
                                                    Width="70"
                                                    DisplayMemberBinding="{Binding TestCount}"/>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_AvgAccuracy}"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding AverageAccuracy, StringFormat=P1}"/>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_BestAccuracy}"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding BestAccuracy, StringFormat=P1}"/>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_AvgTime}"
                                                    Width="110"
                                                    DisplayMemberBinding="{Binding AverageProcessingTime, StringFormat=F1}"/>

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </Grid>

                </GroupBox>

                <GroupBox Header="{DynamicResource Str_Report_DetailedStats}"
                          Margin="0,0,0,10">

                    <Grid Margin="10">

                        <TabControl>

                            <TabItem Header="{DynamicResource Str_Report_Tab_CharAccuracy}">

                                <ListView x:Name="CharacterAccuracyListView"
                                          Height="150"
                                          Style="{DynamicResource ThemedListView}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}"
                                                            Width="120"
                                                            DisplayMemberBinding="{Binding EngineType}"/>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_CharAccuracy}"
                                                            Width="150"
                                                            DisplayMemberBinding="{Binding CharacterAccuracy, StringFormat=P1}"/>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                            <TabItem Header="{DynamicResource Str_Report_Tab_WordAccuracy}">

                                <ListView x:Name="WordAccuracyListView"
                                          Height="150"
                                          Style="{DynamicResource ThemedListView}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}"
                                                            Width="120"
                                                            DisplayMemberBinding="{Binding EngineType}"/>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_WordAccuracy}"
                                                            Width="150"
                                                            DisplayMemberBinding="{Binding WordAccuracy, StringFormat=P1}"/>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                            <TabItem Header="{DynamicResource Str_Report_Tab_LineAccuracy}">

                                <ListView x:Name="LineAccuracyListView"
                                          Height="150"
                                          Style="{DynamicResource ThemedListView}">

                                    <ListView.View>

                                        <GridView>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}"
                                                            Width="120"
                                                            DisplayMemberBinding="{Binding EngineType}"/>

                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_LineAccuracy}"
                                                            Width="150"
                                                            DisplayMemberBinding="{Binding LineAccuracy, StringFormat=P1}"/>

                                        </GridView>

                                    </ListView.View>

                                </ListView>

                            </TabItem>

                        </TabControl>

                    </Grid>

                </GroupBox>

                <GroupBox Header="{DynamicResource Str_Report_Recommendations}"
                          Margin="0,0,0,10">

                    <Grid Margin="10">

                        <ListView x:Name="RecommendationsListView"
                                  Height="120"
                                  Style="{DynamicResource ThemedListView}">

                            <ListView.View>

                                <GridView>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Rec}"
                                                    Width="350"
                                                    DisplayMemberBinding="{Binding Key}"/>

                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Details}"
                                                    Width="350"
                                                    DisplayMemberBinding="{Binding Value}"/>

                                </GridView>

                            </ListView.View>

                        </ListView>

                    </Grid>

                </GroupBox>

            </StackPanel>

        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                Padding="10">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="{DynamicResource Str_Report_Export}"
                        MinWidth="100"
                        Margin="5"
                        Padding="10,5"
                        Style="{DynamicResource ThemedButton}"
                        Click="ExportReportButton_Click"/>

                <Button Content="{DynamicResource Str_Report_Close}"
                        MinWidth="100"
                        Margin="5"
                        Padding="10,5"
                        Style="{DynamicResource ThemedButton}"
                        IsCancel="True"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>