<Window x:Class="GameTranslatorUltimate.AccuracyReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Report_Title}" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Padding="10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Report_Header}" 
                          FontSize="18" FontWeight="Bold" 
                          Foreground="White"/>
                <TextBlock x:Name="ReportDateText" Text="" 
                          FontSize="12" Foreground="LightGray"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel>

                <!-- Summary -->
                <GroupBox Header="{DynamicResource Str_Report_Summary}" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_Report_TotalTests}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalTestsText" Text="0" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_Report_OverallAccuracy}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OverallAccuracyText" Text="N/A" Style="{StaticResource ValueStyle}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Str_Report_BestEngine}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="BestEngineText" Text="None" Style="{StaticResource ValueStyle}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Engine Performance -->
                <GroupBox Header="{DynamicResource Str_Report_EnginePerformance}" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <ListView x:Name="EnginePerformanceListView" Height="200">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}" Width="120" DisplayMemberBinding="{Binding EngineType}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Tests}" Width="60" DisplayMemberBinding="{Binding TestCount}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_AvgAccuracy}" Width="100" DisplayMemberBinding="{Binding AverageAccuracy, StringFormat=P1}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_BestAccuracy}" Width="100" DisplayMemberBinding="{Binding BestAccuracy, StringFormat=P1}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_AvgTime}" Width="100" DisplayMemberBinding="{Binding AverageProcessingTime, StringFormat=F1}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </GroupBox>

                <!-- Detailed Statistics -->
                <GroupBox Header="{DynamicResource Str_Report_DetailedStats}" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <TabControl>
                            <TabItem Header="{DynamicResource Str_Report_Tab_CharAccuracy}">
                                <ListView x:Name="CharacterAccuracyListView" Height="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}" Width="120" DisplayMemberBinding="{Binding EngineType}"/>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_CharAccuracy}" Width="150" DisplayMemberBinding="{Binding CharacterAccuracy, StringFormat=P1}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>

                            <TabItem Header="{DynamicResource Str_Report_Tab_WordAccuracy}">
                                <ListView x:Name="WordAccuracyListView" Height="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}" Width="120" DisplayMemberBinding="{Binding EngineType}"/>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_WordAccuracy}" Width="150" DisplayMemberBinding="{Binding WordAccuracy, StringFormat=P1}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>

                            <TabItem Header="{DynamicResource Str_Report_Tab_LineAccuracy}">
                                <ListView x:Name="LineAccuracyListView" Height="150">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Col_Engine}" Width="120" DisplayMemberBinding="{Binding EngineType}"/>
                                            <GridViewColumn Header="{DynamicResource Str_Report_Tab_LineAccuracy}" Width="150" DisplayMemberBinding="{Binding LineAccuracy, StringFormat=P1}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </GroupBox>

                <!-- Recommendations -->
                <GroupBox Header="{DynamicResource Str_Report_Recommendations}" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <ListView x:Name="RecommendationsListView" Height="100">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Rec}" Width="400" DisplayMemberBinding="{Binding Key}"/>
                                    <GridViewColumn Header="{DynamicResource Str_Report_Col_Details}" Width="300" DisplayMemberBinding="{Binding Value}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Str_Report_Export}" Margin="5" Padding="10,5" Click="ExportReportButton_Click"/>
                <Button Content="{DynamicResource Str_Report_Close}" Margin="5" Padding="10,5" Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
