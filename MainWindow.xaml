<Window x:Class="P5S_ceviri.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:P5S_ceviri"
        mc:Ignorable="d"
        Title="Anlık Oyun Çeviri Aracı" 
        Height="1036" 
        Width="847"
        FontFamily="Segoe UI"
        Style="{DynamicResource ThemedWindow}">

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Üst Panel -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                Background="{DynamicResource SecondaryBackgroundBrush}"
                Padding="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Label Content="Uygulama:" Style="{DynamicResource ThemedLabel}"/>
                <ComboBox Name="cmbProcesses" Width="480" 
                          Style="{DynamicResource ThemedComboBox}"
                          SelectionChanged="CmbProcesses_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconImage}" Width="16" Height="16" 
                                       Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProcessName}" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Name="btnRefresh" Content="Yenile" Margin="10,0"
                        Style="{DynamicResource ThemedButton}"
                        Click="btnRefresh_Click"/>
                <Label Content="Tema:" Style="{DynamicResource ThemedLabel}" Margin="10,0,0,0"/>
                <ComboBox Name="cmbTheme" Width="100" Margin="5,0"
                          Style="{DynamicResource ThemedComboBox}"
                          SelectionChanged="CmbTheme_SelectionChanged">
                    <ComboBoxItem Content="Aydınlık" Tag="Light"/>
                    <ComboBoxItem Content="Karanlık" Tag="Dark"/>
                </ComboBox>
                <Label Name="lblStatus" Content="Hazır." 
                       Style="{DynamicResource ThemedLabel}" 
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Metin Alanları -->
        <GroupBox Header="Orijinal Metin" Grid.Row="1" Grid.Column="0" 
                  Style="{DynamicResource ThemedGroupBox}" Margin="5">
            <TextBox Name="txtOriginal" Style="{DynamicResource ThemedTextBox}" 
                     TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <GroupBox Header="Çevrilmiş Metin" Grid.Row="1" Grid.Column="1" 
                  Style="{DynamicResource ThemedGroupBox}" Margin="5">
            <TextBox Name="txtTranslated" Style="{DynamicResource ThemedTextBox}" 
                     TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        </GroupBox>

        <GridSplitter Grid.Row="2" Grid.ColumnSpan="2" Height="3" HorizontalAlignment="Stretch" 
                       Background="{DynamicResource BorderBrush}"/>

        <!-- Sol Panel Kontrolleri -->
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="5">
            <GroupBox Header="RAM'den Çeviri" Style="{DynamicResource ThemedGroupBox}">
                <StackPanel Margin="5">
                    <Button Name="btnTranslate" Content="RAM Çevirisini Başlat" 
                            Style="{DynamicResource ThemedButton}"
                            Click="btnTranslate_Click"/>
                    <TextBlock Text="Bellek Adresi (Hex):" Margin="0,10,0,5"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBox Name="txtAddress" Style="{DynamicResource ThemedTextBox}"/>
                </StackPanel>
            </GroupBox>

            <Label Content="Çeviri Servisi:" Style="{DynamicResource ThemedLabel}" Margin="5,10,5,0"/>
            <ComboBox x:Name="cmbTranslationService" Margin="5,0,5,5" Padding="5"
                      Style="{DynamicResource ThemedComboBox}"
                      DisplayMemberPath="Name" SelectedValuePath="Type"/>

            <Label Content="OCR Dili:" Style="{DynamicResource ThemedLabel}" Margin="5,10,5,0"/>
            <ComboBox x:Name="cmbOcrLanguage" Margin="5,0,5,5" Padding="5"
                      Style="{DynamicResource ThemedComboBox}"/>

            <Label Content="Hedef Dil:" Style="{DynamicResource ThemedLabel}" Margin="5,10,5,0"/>
            <ComboBox x:Name="cmbTargetLanguage" Margin="5,0,5,5" Padding="5"
                      Style="{DynamicResource ThemedComboBox}"/>

            <CheckBox x:Name="chkEnableColorFilter" Content="OCR Renk Filtresi" 
                      Margin="5,10,5,5" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Sağ Panel Kontrolleri -->
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
            <GroupBox Header="Ekrandan Çeviri (OCR)" Style="{DynamicResource ThemedGroupBox}">
                <StackPanel Margin="5">
                    <TextBlock Text="Seçilen oyun penceresinin otomatik olarak taranacaktır." 
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Name="btnContinuousOcr" Content="Ekran Çevirisini Başlat" 
                            Margin="0,10,0,0" Style="{DynamicResource ThemedButton}"
                            Click="btnContinuousOcr_Click"/>
                    <Separator Margin="0,10" />
                    <TextBlock Text="OCR Motoru:" Margin="0,5,0,5" 
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <ComboBox Name="cmbOcrEngine"
                              Style="{DynamicResource ThemedComboBox}"
                              SelectionChanged="CmbOcrEngine_SelectionChanged">
                        <ComboBoxItem Content="Windows OCR" Tag="Windows"/>
                        <ComboBoxItem Content="Tesseract OCR" Tag="Tesseract"/>
                    </ComboBox>
                    <TextBlock Text="Bu ayarın geçerli olması için uygulamanın yeniden başlatılması gerekir."
                               TextWrapping="Wrap"
                               FontSize="10"
                               FontStyle="Italic"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Görsel Ayarlar" Style="{DynamicResource ThemedGroupBox}" Margin="0,5,0,0">
                <StackPanel Margin="5">
                    <Button x:Name="btnToggleOverlay" Content="Çeviri Penceresini Göster/Gizle" 
                            Style="{DynamicResource ThemedButton}"
                            Click="btnToggleOverlay_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Gelişmiş Pointer Tarama" Style="{DynamicResource ThemedGroupBox}" Margin="0,5,0,0">
                <StackPanel Margin="5">
                    <TextBlock Text="RAM'de aranacak pattern:" Margin="0,0,0,5"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Name="txtScanText" Width="150" Margin="0,0,5,0" 
                                 Style="{DynamicResource ThemedTextBox}"
                                 ToolTip="RAM'de aranacak pattern"/>
                        <Button Name="btnScanPointers" Content="Tara" 
                                Style="{DynamicResource ThemedButton}" Width="60" Margin="5,0,0,0"
                                Click="btnScanPointers_Click"/>
                        <Button Name="btnStopScan" Content="Durdur" 
                                Style="{DynamicResource ThemedButton}" Width="60" Margin="5,0,0,0"
                                Click="btnStopScan_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBlock Text="Encoding:" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ComboBox Name="cmbEncoding" Width="80" Style="{DynamicResource ThemedComboBox}" SelectedIndex="0">
                            <ComboBoxItem Content="Unicode" Tag="Unicode"/>
                            <ComboBoxItem Content="UTF-8" Tag="UTF-8"/>
                            <ComboBoxItem Content="ASCII" Tag="ASCII"/>
                        </ComboBox>
                        <TextBlock Text="Derinlik:" VerticalAlignment="Center" Margin="10,0,5,0"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <ComboBox Name="cmbDepth" Width="50" Style="{DynamicResource ThemedComboBox}" SelectedIndex="1">
                            <ComboBoxItem Content="1" Tag="1"/>
                            <ComboBoxItem Content="2" Tag="2"/>
                            <ComboBoxItem Content="3" Tag="3"/>
                            <ComboBoxItem Content="4" Tag="4"/>
                            <ComboBoxItem Content="5" Tag="5"/>
                        </ComboBox>
                    </StackPanel>

                    <ProgressBar Name="progressScan" Margin="0,0,0,5" Visibility="Collapsed"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 Height="10"/>

                    <TextBlock Name="lblScanStatus" Text="" Margin="0,0,0,5" FontSize="11" 
                               Foreground="{DynamicResource AccentBrush}" Height="12"/>

                    <ListBox Name="lstAddresses" Height="80" Margin="0,5,0,5"
                             Style="{DynamicResource ThemedListBox}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="btnTestPointer" Content="Test Et" 
                                Style="{DynamicResource ThemedButton}"  Width="70" Margin="5,0,0,0"
                                Click="btnTestPointer_Click" />
                        <Button x:Name="btnSavePointers" Content="Kaydet" 
                                Style="{DynamicResource ThemedButton}" Width="70" Margin="5,0,0,0"
                                Click="btnSavePointers_Click"/>
                        <Button x:Name="btnLoadPointers" Content="Yükle" 
                                Style="{DynamicResource ThemedButton}" Width="70" Margin="5,0,0,0"
                                Click="btnLoadPointers_Click"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <!-- Kısayol Ayarları -->
        <GroupBox Header="Kısayol Ayarları" Grid.Row="3" Grid.Column="0" 
                  Style="{DynamicResource ThemedGroupBox}" Margin="0,522,10,24" Grid.RowSpan="2">
            <StackPanel x:Name="HotkeySettingsPanel" Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="OCR Kısayolu:" Style="{DynamicResource ThemedLabel}" Width="100"/>
                    <TextBox x:Name="hotkeyOcr" Width="150" Margin="5,0" IsReadOnly="True" Text="Ctrl+Shift+O"
                             Style="{DynamicResource ThemedTextBox}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="Çeviri Penceresi:" Style="{DynamicResource ThemedLabel}" Width="100"/>
                    <TextBox x:Name="hotkeyTranslateWindow" Width="150" Margin="5,0" IsReadOnly="True" Text="Ctrl+Shift+T"
                             Style="{DynamicResource ThemedTextBox}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <Label Content="Servis Değiştir:" Style="{DynamicResource ThemedLabel}" Width="100"/>
                    <TextBox x:Name="hotkeySwitchService" Width="150" Margin="5,0" IsReadOnly="True" Text="Ctrl+Shift+S"
                             Style="{DynamicResource ThemedTextBox}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Log Alanı -->
        <GroupBox Header="Log" Grid.Row="4" Grid.Column="1" 
                  Style="{DynamicResource ThemedGroupBox}" Margin="5,0,5,5">
            <ListBox Name="txtOutput" Style="{DynamicResource ThemedListBox}"/>
        </GroupBox>
    </Grid>
</Window>