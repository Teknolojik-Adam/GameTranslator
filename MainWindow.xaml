<Window x:Class="GameTranslatorUltimate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameTranslatorUltimate"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Main_Title}"
        Height="1480"
        Width="1240"
        MinHeight="720"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Style="{DynamicResource ThemedWindow}">

    <Grid Background="{DynamicResource PrimaryBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SecondaryBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,18,24,14">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="{DynamicResource Str_Main_Title}"
                               Style="{DynamicResource ThemedTitleTextBlock}"/>

                    <TextBlock Text="{DynamicResource Str_Main_Subtitle}"
                               Style="{DynamicResource ThemedSubtitleTextBlock}"
                               Margin="0,3,0,0"/>

                </StackPanel>

                <Grid Grid.Row="0"
                      Grid.Column="1"
                      VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">

                        <TextBlock Text="{DynamicResource Str_Main_ProcessLabel}"
                                   Style="{DynamicResource ThemedFieldLabel}"/>

                        <ComboBox Name="cmbProcesses"
                                  Height="38"
                                  Style="{DynamicResource ThemedComboBox}"
                                  SelectionChanged="CmbProcesses_SelectionChanged">

                            <ComboBox.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <Image Source="{Binding IconImage}"
                                               Width="18"
                                               Height="18"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                        <TextBlock Text="{Binding ProcessName}"
                                                   VerticalAlignment="Center"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Name="btnRefresh"
                            Content="{DynamicResource Str_Main_Refresh}"
                            Style="{DynamicResource ThemedButtonSecondary}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,18,0"
                            ToolTip="Uygulama listesini yeniler"
                            Click="btnRefresh_Click"/>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,10,0">

                        <TextBlock Text="{DynamicResource Str_Main_ThemeLabel}"
                                   Style="{DynamicResource ThemedFieldLabel}"/>

                        <ComboBox Name="cmbTheme"
                                  Height="38"
                                  Style="{DynamicResource ThemedComboBox}"
                                  SelectionChanged="CmbTheme_SelectionChanged">

                            <ComboBoxItem Content="{DynamicResource Str_Theme_Light}"
                                          Tag="Light"/>

                            <ComboBoxItem Content="{DynamicResource Str_Theme_Dark}"
                                          Tag="Dark"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Column="3">

                        <TextBlock Text="{DynamicResource Str_Main_LanguageLabel}"
                                   Style="{DynamicResource ThemedFieldLabel}"/>

                        <ComboBox Name="cmbLanguage"
                                  Height="38"
                                  Style="{DynamicResource ThemedComboBox}"
                                  SelectionChanged="CmbLanguage_SelectionChanged">

                            <ComboBoxItem Content="{DynamicResource Str_Lang_Turkish}"
                                          Tag="tr"/>

                            <ComboBoxItem Content="{DynamicResource Str_Lang_English}"
                                          Tag="en"/>

                        </ComboBox>

                    </StackPanel>

                </Grid>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{DynamicResource ThemedStatusPill}"
                            HorizontalAlignment="Left">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>

                            <Label Name="lblStatus"
                                   Content="{DynamicResource Str_Status_Ready}"
                                   Style="{DynamicResource ThemedStatusLabel}"/>

                        </StackPanel>

                    </Border>

                    <WrapPanel Grid.Column="1"
                               VerticalAlignment="Center">

                        <Button Name="btnGitHub"
                                Content="GitHub"
                                Style="{DynamicResource ThemedLinkButton}"
                                ToolTip="GitHub reposu"
                                Click="btnGitHub_Click"/>

                        <Button Name="btnAegisWall"
                                Content="AegisWall"
                                Style="{DynamicResource ThemedLinkButton}"
                                ToolTip="AegisWall projesini aç"
                                Click="btnAegisWall_Click"/>

                        <Button Name="btnItchIoTess"
                                Content="GT Tess"
                                Style="{DynamicResource ThemedLinkButton}"
                                ToolTip="GT Tess projesini aç"
                                Click="btnItchIoTess_Click"/>

                        <Button Name="btnGameTranslatorLinux"
                                Content="GT Linux"
                                Style="{DynamicResource ThemedLinkButton}"
                                ToolTip="GameTranslator Linux sayfasını aç"
                                Click="btnGameTranslatorLinux_Click"/>

                        <Button Name="btnItchIo"
                                Content="Itch.io"
                                Style="{DynamicResource ThemedLinkButton}"
                                ToolTip="Itch.io sayfasını aç"
                                Click="btnItchIo_Click"/>

                        <Button Name="btnDonate"
                                Content="Destek Ol"
                                Style="{DynamicResource ThemedButtonDanger}"
                                ToolTip="Projeye destek ol"
                                Click="btnDonate_Click"/>

                    </WrapPanel>

                </Grid>

            </Grid>

        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="True"
                      Padding="0"
                      PanningMode="VerticalOnly">

            <StackPanel Margin="24,20,24,28">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="{DynamicResource Str_Main_OriginalText}"
                              Style="{DynamicResource ThemedGroupBox}"
                              Margin="0,0,8,0"
                              Height="220">

                        <TextBox Name="txtOriginal"
                                 Style="{DynamicResource ThemedTextBox}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontSize="14"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>

                    </GroupBox>

                    <GroupBox Grid.Column="1"
                              Header="{DynamicResource Str_Main_TranslatedText}"
                              Style="{DynamicResource ThemedGroupBox}"
                              Margin="8,0,0,0"
                              Height="220">

                        <TextBox Name="txtTranslated"
                                 Style="{DynamicResource ThemedTextBox}"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontSize="14"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>

                    </GroupBox>

                </Grid>

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,8,0">

                        <GroupBox Header="{DynamicResource Str_Main_RamTranslation}"
                                  Style="{DynamicResource ThemedGroupBox}">

                            <StackPanel>

                                <TextBlock Text="{DynamicResource Str_Main_RamHint}"
                                           Style="{DynamicResource ThemedHintTextBlock}"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{DynamicResource Str_Main_MemoryAddress}"
                                           Style="{DynamicResource ThemedFieldLabel}"
                                           Margin="0,14,0,5"/>

                                <TextBox Name="txtAddress"
                                         Style="{DynamicResource ThemedTextBox}"
                                         Height="38"/>

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Name="btnTranslate"
                                            Content="{DynamicResource Str_Main_StartRam}"
                                            Style="{DynamicResource ThemedButtonPrimary}"
                                            Margin="0,0,5,0"
                                            ToolTip="RAM üzerinden otomatik çeviriyi başlatır veya durdurur"
                                            Click="btnTranslate_Click"/>

                                    <Button Grid.Column="1"
                                            Name="btnVideoOcr"
                                            Content="{DynamicResource Str_Main_OpenVideoOcr}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="5,0,0,0"
                                            ToolTip="Canlı video OCR penceresini açar"
                                            Click="btnVideoOcr_Click"/>

                                </Grid>

                            </StackPanel>

                        </GroupBox>

                        <GroupBox Header="{DynamicResource Str_Main_TranslationSettings}"
                                  Style="{DynamicResource ThemedGroupBox}"
                                  Margin="0,14,0,0">

                            <StackPanel>

                                <TextBlock Text="{DynamicResource Str_Main_TranslationService}"
                                           Style="{DynamicResource ThemedFieldLabel}"/>

                                <ComboBox x:Name="cmbTranslationService"
                                          Height="38"
                                          DisplayMemberPath="Name"
                                          Style="{DynamicResource ThemedComboBox}"
                                          SelectionChanged="cmbTranslationService_SelectionChanged"/>

                                <StackPanel x:Name="pnlOllamaSettings"
                                            Visibility="Collapsed"
                                            Margin="0,12,0,0">

                                    <TextBlock Text="Ollama API URL"
                                               Style="{DynamicResource ThemedFieldLabel}"/>

                                    <TextBox x:Name="txtOllamaApiUrl"
                                             Height="36"
                                             Style="{DynamicResource ThemedTextBox}"
                                             ToolTip="Örn: http://localhost:11434"
                                             TextChanged="txtOllamaApiUrl_TextChanged"/>

                                    <TextBlock Text="Ollama Model Adı"
                                               Style="{DynamicResource ThemedFieldLabel}"
                                               Margin="0,10,0,5"/>

                                    <TextBox x:Name="txtOllamaModelName"
                                             Height="36"
                                             Style="{DynamicResource ThemedTextBox}"
                                             ToolTip="Örn: llama3:8b"
                                             TextChanged="txtOllamaModelName_TextChanged"/>

                                    <TextBlock Text="{DynamicResource Str_Main_OllamaSaveHint}"
                                               Style="{DynamicResource ThemedHintTextBlock}"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0"/>

                                </StackPanel>

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,6,0">

                                        <TextBlock Text="{DynamicResource Str_Main_OcrLanguage}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox x:Name="cmbOcrLanguage"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="cmbOcrLanguage_SelectionChanged"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0">

                                        <TextBlock Text="{DynamicResource Str_Main_TargetLanguage}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox x:Name="cmbTargetLanguage"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="cmbTargetLanguage_SelectionChanged"/>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </GroupBox>

                        <Expander Header="{DynamicResource Str_Main_AdvancedTextProcessing}"
                                  Style="{DynamicResource ThemedExpander}"
                                  Margin="0,14,0,0">

                            <StackPanel>

                                <TextBlock Text="{DynamicResource Str_Main_AdvancedTextHint}"
                                           Style="{DynamicResource ThemedHintTextBlock}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10"/>

                                <CheckBox x:Name="chkEnableColorFilter"
                                          Content="{DynamicResource Str_Main_OcrColorFilter}"
                                          Style="{DynamicResource ThemedCheckBox}"
                                          Checked="chkEnableColorFilter_Checked"/>

                                <CheckBox x:Name="chkEnableSkewCorrection"
                                          Content="{DynamicResource Str_Main_SkewCorrection}"
                                          Style="{DynamicResource ThemedCheckBox}"/>

                                <CheckBox x:Name="chkEnableHandwritingMode"
                                          Content="{DynamicResource Str_Main_HandwritingMode}"
                                          Style="{DynamicResource ThemedCheckBox}"/>

                                <CheckBox x:Name="chkEnableSuperResolution"
                                          Content="{DynamicResource Str_Main_SuperResolution}"
                                          Style="{DynamicResource ThemedCheckBox}"/>

                                <CheckBox x:Name="chkEnableAnomalyDetection"
                                          Content="{DynamicResource Str_Main_AnomalyDetection}"
                                          Style="{DynamicResource ThemedCheckBox}"
                                          Checked="chkEnableAnomalyDetection_Checked"
                                          Unchecked="chkEnableAnomalyDetection_Unchecked"/>

                                <CheckBox x:Name="chkEnableMachineLearning"
                                          Content="{DynamicResource Str_Main_MachineLearning}"
                                          Style="{DynamicResource ThemedCheckBox}"
                                          Checked="chkEnableMachineLearning_Checked"
                                          Unchecked="chkEnableMachineLearning_Unchecked"/>

                                <CheckBox x:Name="chkEnableTextCorrection"
                                          Content="{DynamicResource Str_Main_TextCorrection}"
                                          Style="{DynamicResource ThemedCheckBox}"
                                          Checked="chkEnableTextCorrection_Checked"
                                          Unchecked="chkEnableTextCorrection_Unchecked"/>

                                <CheckBox x:Name="chkEnableContextAnalysis"
                                          Content="{DynamicResource Str_Main_ContextAnalysis}"
                                          Style="{DynamicResource ThemedCheckBox}"
                                          Checked="chkEnableContextAnalysis_Checked"
                                          Unchecked="chkEnableContextAnalysis_Unchecked"/>

                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnMLStatistics"
                                            Content="{DynamicResource Str_Main_MlStats}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="0,0,5,0"
                                            Click="btnMLStatistics_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnAnomalyStatistics"
                                            Content="{DynamicResource Str_Main_AnomalyStats}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="5,0,0,0"
                                            Click="btnAnomalyStatistics_Click"/>

                                </Grid>

                                <Grid Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnClearMLHistory"
                                            Content="{DynamicResource Str_Main_ClearMl}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Margin="0,0,5,0"
                                            Click="btnClearMLHistory_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnClearAnomalyHistory"
                                            Content="{DynamicResource Str_Main_ClearAnomaly}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Margin="5,0,0,0"
                                            Click="btnClearAnomalyHistory_Click"/>

                                </Grid>

                            </StackPanel>

                        </Expander>

                        <Expander Header="{DynamicResource Str_Grp_Shortcuts}"
                                  Style="{DynamicResource ThemedExpander}"
                                  Margin="0,14,0,0">

                            <StackPanel x:Name="HotkeySettingsPanel">

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Content="{DynamicResource Str_Lbl_HotkeyOcr}"
                                           Style="{DynamicResource ThemedLabel}"/>

                                    <local:HotkeyInputControl Grid.Column="1"
                                                              Hotkey="{Binding ToggleOcrHotkey, Mode=TwoWay}"
                                                              Height="36"/>

                                </Grid>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Content="{DynamicResource Str_Lbl_HotkeyWindow}"
                                           Style="{DynamicResource ThemedLabel}"/>

                                    <local:HotkeyInputControl Grid.Column="1"
                                                              Hotkey="{Binding ToggleTranslateWindowHotkey, Mode=TwoWay}"
                                                              Height="36"/>

                                </Grid>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Content="{DynamicResource Str_Lbl_HotkeyService}"
                                           Style="{DynamicResource ThemedLabel}"/>

                                    <local:HotkeyInputControl Grid.Column="1"
                                                              Hotkey="{Binding SwitchTranslationServiceHotkey, Mode=TwoWay}"
                                                              Height="36"/>

                                </Grid>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="8,0,0,0">

                        <GroupBox Header="{DynamicResource Str_Main_ScreenTranslation}"
                                  Style="{DynamicResource ThemedGroupBox}">

                            <StackPanel>

                                <TextBlock Text="{DynamicResource Str_Main_ScreenOcrInfo}"
                                           Style="{DynamicResource ThemedHintTextBlock}"
                                           TextWrapping="Wrap"/>

                                <Grid Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Name="btnContinuousOcr"
                                            Content="{DynamicResource Str_Main_StartScreenOcr}"
                                            Style="{DynamicResource ThemedButtonPrimary}"
                                            Margin="0,0,5,0"
                                            ToolTip="Seçilen pencereyi sürekli OCR ile çevirir"
                                            Click="btnContinuousOcr_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnSelectOcrRegion"
                                            Content="{DynamicResource Str_Main_OcrRegion}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="5,0,0,0"
                                            ToolTip="OCR için ekran bölgesi seç"
                                            Click="btnSelectOcrRegion_Click"/>

                                </Grid>

                                <Grid Margin="0,16,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,6,0">

                                        <TextBlock Text="{DynamicResource Str_Main_OcrEngine}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbOcrEngine"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="CmbOcrEngine_SelectionChanged">

                                            <ComboBoxItem Content="{DynamicResource Str_Ocr_Windows}"
                                                          Tag="Windows"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Ocr_Tesseract}"
                                                          Tag="Tesseract"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0">

                                        <TextBlock Text="{DynamicResource Str_Main_TextDetectionMethod}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbTextDetectionMethod"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="CmbTextDetectionMethod_SelectionChanged">

                                            <ComboBoxItem Content="{DynamicResource Str_Method_East}"
                                                          Tag="East"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Method_OpenCV}"
                                                          Tag="OpenCV"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Method_None}"
                                                          Tag="None"/>

                                        </ComboBox>

                                    </StackPanel>

                                </Grid>

                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,6,0">

                                        <TextBlock Text="{DynamicResource Str_Main_TesseractPsm}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbPageSegMode"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="CmbPageSegMode_SelectionChanged">

                                            <ComboBoxItem Content="Auto"
                                                          Tag="Auto"/>

                                            <ComboBoxItem Content="Single Line"
                                                          Tag="SingleLine"/>

                                            <ComboBoxItem Content="Sparse Text"
                                                          Tag="SparseText"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0">

                                        <TextBlock Text="{DynamicResource Str_Main_DnnModel}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbDnnModel"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectionChanged="CmbDnnModel_SelectionChanged">

                                            <ComboBoxItem Content="{DynamicResource Str_Model_East}"
                                                          Tag="EAST"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Model_Crnn}"
                                                          Tag="CRNN"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Model_Paddle}"
                                                          Tag="PaddleOCR"/>

                                            <ComboBoxItem Content="{DynamicResource Str_Model_Custom}"
                                                          Tag="Custom"/>

                                        </ComboBox>

                                    </StackPanel>

                                </Grid>

                                <TextBlock Text="{DynamicResource Str_Main_RestartHint}"
                                           Style="{DynamicResource ThemedHintTextBlock}"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>

                            </StackPanel>

                        </GroupBox>

                        <GroupBox Header="{DynamicResource Str_Main_VisualSettings}"
                                  Style="{DynamicResource ThemedGroupBox}"
                                  Margin="0,14,0,0">

                            <Button x:Name="btnToggleOverlay"
                                    Content="{DynamicResource Str_Main_ToggleOverlay}"
                                    Style="{DynamicResource ThemedButtonSecondary}"
                                    ToolTip="Çeviri penceresini gösterir veya gizler"
                                    Click="btnToggleOverlay_Click"/>

                        </GroupBox>

                        <Expander Header="{DynamicResource Str_Main_AdvancedPointerScan}"
                                  Style="{DynamicResource ThemedExpander}"
                                  Margin="0,14,0,0">

                            <StackPanel>

                                <TextBlock Text="{DynamicResource Str_Main_ScanPattern}"
                                           Style="{DynamicResource ThemedFieldLabel}"/>

                                <Grid Margin="0,5,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Name="txtScanText"
                                             Height="38"
                                             Style="{DynamicResource ThemedTextBox}"
                                             ToolTip="{DynamicResource Str_Main_ScanPattern}"/>

                                    <Button Grid.Column="1"
                                            Name="btnScanPointers"
                                            Content="{DynamicResource Str_Main_Scan}"
                                            Style="{DynamicResource ThemedButtonPrimary}"
                                            Margin="8,0,0,0"
                                            Click="btnScanPointers_Click"/>

                                    <Button Grid.Column="2"
                                            Name="btnStopScan"
                                            Content="{DynamicResource Str_Stop}"
                                            Style="{DynamicResource ThemedButtonDanger}"
                                            Margin="8,0,0,0"
                                            Click="btnStopScan_Click"/>

                                </Grid>

                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,6,0">

                                        <TextBlock Text="{DynamicResource Str_Main_Encoding}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbEncoding"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectedIndex="0">

                                            <ComboBoxItem Content="Unicode"
                                                          Tag="Unicode"/>

                                            <ComboBoxItem Content="UTF-8"
                                                          Tag="UTF-8"/>

                                            <ComboBoxItem Content="ASCII"
                                                          Tag="ASCII"/>

                                        </ComboBox>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="6,0,0,0">

                                        <TextBlock Text="{DynamicResource Str_Main_Depth}"
                                                   Style="{DynamicResource ThemedFieldLabel}"/>

                                        <ComboBox Name="cmbDepth"
                                                  Height="38"
                                                  Style="{DynamicResource ThemedComboBox}"
                                                  SelectedIndex="1">

                                            <ComboBoxItem Content="1"
                                                          Tag="1"/>

                                            <ComboBoxItem Content="2"
                                                          Tag="2"/>

                                            <ComboBoxItem Content="3"
                                                          Tag="3"/>

                                            <ComboBoxItem Content="4"
                                                          Tag="4"/>

                                            <ComboBoxItem Content="5"
                                                          Tag="5"/>

                                        </ComboBox>

                                    </StackPanel>

                                </Grid>

                                <ProgressBar Name="progressScan"
                                             Height="8"
                                             Visibility="Collapsed"
                                             Margin="0,14,0,5"
                                             Style="{DynamicResource ThemedProgressBar}"/>

                                <TextBlock Name="lblScanStatus"
                                           Text=""
                                           Style="{DynamicResource ThemedHintTextBlock}"
                                           Height="18"/>

                                <ListBox Name="lstAddresses"
                                         Height="110"
                                         Margin="0,5,0,0"
                                         Style="{DynamicResource ThemedListBox}"/>

                                <Grid Margin="0,12,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnTestPointer"
                                            Content="{DynamicResource Str_Main_Test}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="0,0,4,0"
                                            Click="btnTestPointer_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnSavePointers"
                                            Content="{DynamicResource Str_Save}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="4,0"
                                            Click="btnSavePointers_Click"/>

                                    <Button Grid.Column="2"
                                            x:Name="btnLoadPointers"
                                            Content="{DynamicResource Str_Main_Load}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            Margin="4,0,0,0"
                                            Click="btnLoadPointers_Click"/>

                                </Grid>

                                <Grid Margin="0,8,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            x:Name="btnCompareMemoryPatterns"
                                            Content="{DynamicResource Str_Main_PointerMemoryCompare}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Margin="0,0,4,0"
                                            Click="btnCompareMemoryPatterns_Click"/>

                                    <Button Grid.Column="1"
                                            x:Name="btnClearPointerCache"
                                            Content="{DynamicResource Str_Main_ClearPointerCache}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Margin="4,0"
                                            Click="btnClearPointerCache_Click"/>

                                    <Button Grid.Column="2"
                                            x:Name="btnListPointerCache"
                                            Content="{DynamicResource Str_Main_ListPointerCache}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Margin="4,0,0,0"
                                            Click="btnListPointerCache_Click"/>

                                </Grid>

                            </StackPanel>

                        </Expander>

                        <GroupBox Header="{DynamicResource Str_Main_Log}"
                                  Style="{DynamicResource ThemedGroupBox}"
                                  Margin="0,14,0,0"
                                  Height="250">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         Name="txtOutput"
                                         Style="{DynamicResource ThemedListBox}"
                                         ItemsSource="{Binding LogEntries, RelativeSource={RelativeSource AncestorType=Window}}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         IsSynchronizedWithCurrentItem="False">

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <TextBlock Text="{Binding FullText}"
                                                       TextWrapping="Wrap"
                                                       Style="{DynamicResource ThemedLogTextBlock}"/>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>

                                </ListBox>

                                <WrapPanel Grid.Row="1"
                                           Margin="0,10,0,0">

                                    <Button x:Name="btnViewLogFile"
                                            Content="{DynamicResource Str_Main_ViewLog}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Click="btnViewLogFile_Click"/>

                                    <Button x:Name="btnClearLogFile"
                                            Content="{DynamicResource Str_Main_ClearLog}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Click="btnClearLogFile_Click"/>

                                </WrapPanel>

                            </Grid>

                        </GroupBox>

                        <Expander Header="{DynamicResource Str_Main_Maintenance}"
                                  Style="{DynamicResource ThemedExpander}"
                                  Margin="0,14,0,0">

                            <StackPanel>

                                <WrapPanel>

                                    <Button x:Name="btnReloadGameRecipes"
                                            Content="{DynamicResource Str_Main_ReloadSettings}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            ToolTip="game_recipes.json dosyasını yeniden yükler"
                                            Click="ReloadGameRecipes_Click"/>

                                    <Button x:Name="btnSaveSettings"
                                            Content="{DynamicResource Str_Main_SaveSettings}"
                                            Style="{DynamicResource ThemedButtonSecondary}"
                                            ToolTip="Ayarları hemen diske kaydeder"
                                            Click="SaveSettingsNow_Click"/>

                                    <Button x:Name="btnResetSettings"
                                            Content="{DynamicResource Str_Main_ResetSettings}"
                                            Style="{DynamicResource ThemedButtonDanger}"
                                            ToolTip="Tüm ayarları varsayılan değerlere döndürür"
                                            Click="ResetSettingsToDefaults_Click"/>

                                </WrapPanel>

                                <WrapPanel Margin="0,6,0,0">

                                    <Button x:Name="btnClearAllCaches"
                                            Content="{DynamicResource Str_Main_ClearCaches}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            ToolTip="Çeviri, bellek, öneri ve ikon önbelleklerini temizler"
                                            Click="ClearAllCaches_Click"/>

                                    <Button x:Name="btnClearTranslationCache"
                                            Content="{DynamicResource Str_Main_ClearTranslationCache}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Click="btnClearTranslationCache_Click"/>

                                    <Button x:Name="btnSaveTranslationCache"
                                            Content="{DynamicResource Str_Main_SaveTranslationCache}"
                                            Style="{DynamicResource ThemedButtonGhost}"
                                            Click="btnSaveTranslationCache_Click"/>

                                </WrapPanel>

                            </StackPanel>

                        </Expander>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>