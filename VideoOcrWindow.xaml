<Window x:Class="GameTranslatorUltimate.VideoOcrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Video_Title}" Height="1053" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        Style="{DynamicResource ThemedWindow}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BaÅŸlÄ±k -->
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" Padding="18,14">
                <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Str_Video_Header}"
                          FontSize="18" FontWeight="Bold"
                          Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Str_Video_StatusStopped}"
                          FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                          Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Ana Ä°Ã§erik -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Video ve SonuÃ§lar Paneli -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video GÃ¶rÃ¼ntÃ¼sÃ¼ -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="2" CornerRadius="8">
                    <Grid Background="Black">
                        <Image x:Name="VideoDisplay" Stretch="Uniform"
                              Width="640" Height="480"/>
                        <TextBlock x:Name="VideoPlaceholder"
                                  Text="{DynamicResource Str_Video_NoFeed}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="Gray"
                                  FontSize="16"/>
                    </Grid>
                </Border>

                <!-- OCR SonuÃ§larÄ± -->
                <GroupBox Grid.Row="1" Header="{DynamicResource Str_Video_OcrResults}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- SonuÃ§ BaÅŸlÄ±ÄŸÄ± -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{DynamicResource Str_Video_Engine}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="EngineText" Text="HiÃ§biri" Margin="5,0,20,0"/>
                            <TextBlock Text="{DynamicResource Str_Video_Confidence}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="ConfidenceText" Text="%0" Margin="5,0,20,0"/>
                            <TextBlock Text="{DynamicResource Str_Video_Frame}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="FrameText" Text="0" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- TanÄ±nan Metin -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource ReadOnlyBackgroundBrush}">
                                <TextBlock x:Name="RecognizedTextBlock"
                                          Text="{DynamicResource Str_Video_NoText}"
                                          TextWrapping="Wrap"
                                          FontFamily="Consolas"
                                          FontSize="12"
                                          Padding="10"/>
                            </Border>
                        </ScrollViewer>

                        <!-- DoÄŸruluk PuanÄ± -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5"
                                   Visibility="{Binding ElementName=EnableAccuracyScoringCheckBox, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Str_Video_Accuracy}" Style="{StaticResource LabelStyle}"/>
                            <TextBlock x:Name="AccuracyText" Text="Yok" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- Kontrol Paneli -->
            <Grid Grid.Column="1" Margin="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Video AyarlarÄ± -->
                        <GroupBox Header="{DynamicResource Str_Video_VideoSettings}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="{DynamicResource Str_Video_Cameras}" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="CameraComboBox" Margin="0,0,0,10"
                                         SelectionChanged="CameraComboBox_SelectionChanged"/>

                                <TextBlock Text="{DynamicResource Str_Video_FrameRate}" Style="{StaticResource LabelStyle}"/>
                                <Slider x:Name="FrameRateSlider" Minimum="1" Maximum="60" Value="30"
                                       TickFrequency="5" IsSnapToTickEnabled="True"
                                       ValueChanged="FrameRateSlider_ValueChanged"/>
                                <TextBlock x:Name="FrameRateText" Text="30 FPS" HorizontalAlignment="Center"/>

                                <TextBlock Text="{DynamicResource Str_Video_Resolution}" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="ResolutionComboBox" Margin="0,0,0,10"
                                         SelectionChanged="ResolutionComboBox_SelectionChanged">
                                    <ComboBoxItem Content="640x480" Tag="640,480"/>
                                    <ComboBoxItem Content="800x600" Tag="800,600"/>
                                    <ComboBoxItem Content="1024x768" Tag="1024,768"/>
                                    <ComboBoxItem Content="1280x720" Tag="1280,720"/>
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <!-- OCR AyarlarÄ± -->
                        <GroupBox Header="{DynamicResource Str_Video_OcrSettings}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnableComparisonCheckBox" Content="{DynamicResource Str_Video_EnableComparison}"
                                         IsChecked="True" Margin="0,0,0,5"/>
                                <CheckBox x:Name="EnableAccuracyScoringCheckBox" Content="{DynamicResource Str_Video_EnableAccuracy}"
                                         Margin="0,0,0,5"/>
                                <CheckBox x:Name="EnableRegionDetectionCheckBox" Content="{DynamicResource Str_Video_EnableRegion}"
                                         IsChecked="True" Margin="0,0,0,5"/>

                                <TextBlock Text="{DynamicResource Str_Video_ConfidenceThreshold}" Style="{StaticResource LabelStyle}"/>
                                <Slider x:Name="ConfidenceThresholdSlider" Minimum="0" Maximum="1" Value="0.7"
                                       TickFrequency="0.1" IsSnapToTickEnabled="True"
                                       ValueChanged="ConfidenceThresholdSlider_ValueChanged"/>
                                <TextBlock x:Name="ConfidenceThresholdText" Text="%70" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Referans Metin -->
                        <GroupBox Header="{DynamicResource Str_Video_ReferenceText}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="{DynamicResource Str_Video_ExpectedText}" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="GroundTruthTextBox" Height="60"
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        TextChanged="GroundTruthTextBox_TextChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Kontrol DÃ¼ÄŸmeleri -->
                        <GroupBox Header="{DynamicResource Str_Video_Controls}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <Button x:Name="StartButton" Content="{DynamicResource Str_Video_Start}"
                                       Style="{DynamicResource ThemedButtonPrimary}"
                                       Click="StartButton_Click"/>
                                <Button x:Name="StopButton" Content="{DynamicResource Str_Video_Stop}"
                                       Style="{DynamicResource ThemedButtonDanger}"
                                       Click="StopButton_Click" IsEnabled="False"/>
                                <Button x:Name="CaptureFrameButton" Content="{DynamicResource Str_Video_CaptureFrame}"
                                       Style="{DynamicResource ThemedButtonSecondary}"
                                       Click="CaptureFrameButton_Click"/>
                                <Button x:Name="GenerateReportButton" Content="{DynamicResource Str_Video_GenerateReport}"
                                       Style="{DynamicResource ThemedButtonSecondary}"
                                       Click="GenerateReportButton_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Ä°statistikler -->
                        <GroupBox Header="{DynamicResource Str_Video_Stats}" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <TextBlock Text="{DynamicResource Str_Video_FramesProcessed}" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="FramesProcessedText" Text="0" Margin="0,0,0,5"/>

                                <TextBlock Text="{DynamicResource Str_Video_AvgTime}" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="AvgProcessingTimeText" Text="0 ms" Margin="0,0,0,5"/>

                                <TextBlock Text="{DynamicResource Str_Video_BestEngine}" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="BestEngineText" Text="HiÃ§biri" Margin="0,0,0,5"/>

                                <TextBlock Text="{DynamicResource Str_Video_OverallAccuracy}" Style="{StaticResource LabelStyle}"/>
                                <TextBlock x:Name="OverallAccuracyText" Text="Yok" Margin="0,0,0,5"/>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Durum Ã‡ubuÄŸu -->
        <StatusBar Grid.Row="2" Background="{DynamicResource SecondaryBackgroundBrush}">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="HazÄ±r"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PerformanceText" Text="Performans: Yok"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
