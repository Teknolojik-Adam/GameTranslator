<UserControl x:Class="GameTranslatorUltimate.HotkeyInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameTranslatorUltimate"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="200">
    <TextBox x:Name="HotkeyTextBox"
             IsReadOnly="True"
             Padding="5"
             GotFocus="HotkeyTextBox_GotFocus"
             LostFocus="HotkeyTextBox_LostFocus"
             KeyDown="HotkeyTextBox_KeyDown"
             TextAlignment="Center"
             VerticalContentAlignment="Center"
             ToolTip="{DynamicResource Str_Hotkey_Tooltip}"/>
</UserControl>
