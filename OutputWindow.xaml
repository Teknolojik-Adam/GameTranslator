<Window x:Class="GameTranslatorUltimate.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çıktı Penceresi"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_KeyDown">

    <Grid>
        <Border x:Name="DisplayBorder"
                Background="#E6000000"
                CornerRadius="6"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">

            <TextBlock x:Name="txtOutputDisplay"
                       Text="Çeviri burada görünecek..."
                       Margin="12,8"
                       Foreground="White"
                       FontSize="16"
                       MaxWidth="700"
                       TextWrapping="Wrap"/>
        </Border>

        <Canvas x:Name="SelectionCanvas"
                Background="#40000000"
                Cursor="Cross"
                Visibility="Collapsed"
                MouseLeftButtonDown="SelectionCanvas_MouseDown"
                MouseMove="SelectionCanvas_MouseMove"
                MouseLeftButtonUp="SelectionCanvas_MouseUp">

            <Rectangle x:Name="SelectionRectangle"
                       Stroke="LimeGreen"
                       StrokeThickness="2"
                       Fill="#2800FF00"
                       Visibility="Collapsed"/>
        </Canvas>
    </Grid>
</Window>