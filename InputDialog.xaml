<Window x:Class="GameTranslatorUltimate.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Input_Title}"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ContentRendered="Window_ContentRendered">

    <Border Padding="15"
            Background="{DynamicResource PrimaryBackgroundBrush}">

        <StackPanel>

            <TextBlock x:Name="lblQuestion"
                       Text="{DynamicResource Str_Input_Question}"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="400"/>

            <TextBox x:Name="txtAnswer"
                     MinWidth="250"
                     MaxWidth="500"
                     Margin="0,10,0,15"
                     Style="{DynamicResource ThemedTextBox}"/>

            <WrapPanel HorizontalAlignment="Right">

                <Button x:Name="btnDialogOk"
                        IsDefault="True"
                        MinWidth="80"
                        Margin="0,0,10,0"
                        Style="{DynamicResource ThemedButton}"
                        Click="btnDialogOk_Click"
                        Content="{DynamicResource Str_Ok}" Height="38"/>

                <Button x:Name="btnDialogCancel"
                        IsCancel="True"
                        MinWidth="80"
                        Style="{DynamicResource ThemedButton}"
                        Content="{DynamicResource Str_Cancel}"/>

            </WrapPanel>

        </StackPanel>

    </Border>

</Window>