<Window x:Class="GameTranslatorUltimate.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Input_Title}" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ContentRendered="Window_ContentRendered">
    <StackPanel Margin="15">
        <TextBlock x:Name="lblQuestion" 
                   Text="{DynamicResource Str_Input_Question}" 
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" 
                   MaxWidth="400"/>

        <TextBox x:Name="txtAnswer" MinWidth="250" Margin="0,10,0,15"
                 Style="{DynamicResource ThemedTextBox}"/>

        <WrapPanel HorizontalAlignment="Right">
            <Button IsDefault="True" Name="btnDialogOk" MinWidth="80" Margin="0,0,10,0"
                    Style="{DynamicResource ThemedButton}"
                    Click="btnDialogOk_Click" 
                    Content="{DynamicResource Str_Ok}" Height="15"/>

            <Button IsCancel="True" MinWidth="80"
                    Style="{DynamicResource ThemedButton}" 
                    Content="{DynamicResource Str_Cancel}" Height="15"/>
        </WrapPanel>
    </StackPanel>
</Window>
