<Window x:Class="P5S_ceviri.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ContentRendered="Window_ContentRendered">
    <StackPanel Margin="15">
        <TextBlock x:Name="lblQuestion" Text="Soru:" 
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox x:Name="txtAnswer" MinWidth="250" Margin="0,5,0,10"
                 Style="{DynamicResource ThemedTextBox}"/>
        <WrapPanel HorizontalAlignment="Right">
            <Button IsDefault="True" Name="btnDialogOk" MinWidth="60" Margin="0,0,10,0"
                    Style="{DynamicResource ThemedButton}"
                    Click="btnDialogOk_Click" Height="16">_Ok</Button>
            <Button IsCancel="True" MinWidth="60"
                    Style="{DynamicResource ThemedButton}">_Cancel</Button>
        </WrapPanel>
    </StackPanel>
</Window>